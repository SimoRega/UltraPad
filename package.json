{
  "name": "ultrapad",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "node scripts/prepare-ocr.mjs && vite --config apps/web/vite.config.ts",
    "dev:api": "wrangler dev --config apps/api/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "node scripts/prepare-ocr.mjs && vite build --config apps/web/vite.config.ts",
    "build:api": "wrangler deploy --dry-run --config apps/api/wrangler.jsonc --outdir dist/api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:rls": "node scripts/test-rls.mjs",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.jsonc",
    "deploy:web": "wrangler pages deploy apps/web/dist --project-name ultrapad",
    "doctor": "node scripts/doctor.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:setup": "node --test tests/setup.spec.mjs",
    "desktop:build": "pnpm build:web && node scripts/prepare-desktop.mjs",
    "desktop:start": "pnpm desktop:build && pnpm desktop:runtime && pnpm --dir apps/desktop exec electron .",
    "desktop:package": "pnpm desktop:build && pnpm exec electron-forge package apps/desktop",
    "desktop:make": "pnpm desktop:build && pnpm exec electron-forge make apps/desktop",
    "test:desktop": "node --test tests/desktop/security.test.mjs",
    "test:desktop:e2e": "pnpm desktop:runtime && playwright test --config tests/desktop/playwright.config.ts",
    "desktop:runtime": "pnpm --dir apps/desktop exec install-electron"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "dompurify": "3.4.16",
    "hono": "4.13.13",
    "idb": "8.0.3",
    "jszip": "3.10.2",
    "latex.js": "0.12.6",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.2",
    "monaco-editor": "0.57.0",
    "quill": "2.0.3",
    "quill-cursors": "4.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tesseract.js": "6.0.1",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "y-quill": "1.0.0",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261004.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.55.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.1",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1"
  }
}
